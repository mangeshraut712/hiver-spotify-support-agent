# OpenAI API key (or OpenRouter key)
OPENAI_API_KEY=

# Optional OpenAI-compatible gateway (OpenRouter example).
# Must be https. http is accepted only for localhost.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_AGENT_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENAI_JUDGE_MODEL=nvidia/nemotron-3.5-lightning:free

# Defaults when using OpenAI directly:
OPENAI_AGENT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o

# Set to "retrieval" to skip LLM reply calls during offline eval
# AGENT_REPLY_MODE=retrieval

# Optional: local path to twcs.csv if skipping kagglehub
# TWCS_CSV_PATH=
